`timescale 1ns/1ps

module round_robin_arbiter (
    input            clk,
    input            rst,
    input      [3:0] req,
    output reg [3:0] gnt
);

    reg [1:0] priority_ptr;
    reg [3:0] next_gnt;

    // Select one active request in circular priority order.
    always @(*) begin
        next_gnt = 4'b0000;

        case (priority_ptr)
            2'd0: begin
                if      (req[0]) next_gnt = 4'b0001;
                else if (req[1]) next_gnt = 4'b0010;
                else if (req[2]) next_gnt = 4'b0100;
                else if (req[3]) next_gnt = 4'b1000;
            end

            2'd1: begin
                if      (req[1]) next_gnt = 4'b0010;
                else if (req[2]) next_gnt = 4'b0100;
                else if (req[3]) next_gnt = 4'b1000;
                else if (req[0]) next_gnt = 4'b0001;
            end

            2'd2: begin
                if      (req[2]) next_gnt = 4'b0100;
                else if (req[3]) next_gnt = 4'b1000;
                else if (req[0]) next_gnt = 4'b0001;
                else if (req[1]) next_gnt = 4'b0010;
            end

            2'd3: begin
                if      (req[3]) next_gnt = 4'b1000;
                else if (req[0]) next_gnt = 4'b0001;
                else if (req[1]) next_gnt = 4'b0010;
                else if (req[2]) next_gnt = 4'b0100;
            end
        endcase
    end

    // Register the grant and update priority after a successful grant.
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            gnt          <= 4'b0000;
            priority_ptr <= 2'd0;
        end
        else begin
            gnt <= next_gnt;

            case (next_gnt)
                4'b0001: priority_ptr <= 2'd1;
                4'b0010: priority_ptr <= 2'd2;
                4'b0100: priority_ptr <= 2'd3;
                4'b1000: priority_ptr <= 2'd0;

                // No request: keep the same priority.
                default: priority_ptr <= priority_ptr;
            endcase
        end
    end

endmodule